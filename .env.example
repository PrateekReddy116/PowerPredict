# Copy to .env and replace every placeholder. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=powerpredict
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=powerpredict
POSTGRES_PORT=5432

# Used by the FastAPI app on the host
DATABASE_URL=postgresql://powerpredict:change-this-postgres-password@localhost:5432/powerpredict

# --- JWT (required; min 32 characters) ---
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_EXPIRE_MINUTES=60

# --- CORS: comma-separated origins only. Wildcard * is rejected at startup. ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limits (requests per minute) ---
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_USER_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false

# --- Seed admin (created on API startup if the email is not already present) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password

# --- MQTT / Mosquitto (credentials live here, not in source) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=powerpredict
MQTT_PASSWORD=change-this-mqtt-password
MQTT_TOPIC_PREFIX=smartbuilding
MQTT_ENABLED=true
# MQTT_CLIENT_ID=powerpredict-api

# --- Offline artifacts the API may serve (SHAP JSON under explanations/) ---
# ARTIFACTS_DIR=artifacts

# --- Isolation Forest severity (optional; unused until Phase 5 product work) ---
ANOMALY_WARNING_DEVIATION_PCT=25
ANOMALY_CRITICAL_DEVIATION_PCT=50
# Optional sklearn decision_function cutoffs (more negative = more anomalous). Leave unset to ignore.
# ANOMALY_WARNING_SCORE_CUTOFF=
# ANOMALY_CRITICAL_SCORE_CUTOFF=
ANOMALY_FLAG_IF_OUTLIER=true
ANOMALY_EXPECTED_FLOOR_KWH=1.0
ANOMALY_CONTAMINATION=0.01
ANOMALY_RANDOM_SEED=42
